# .env.example - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ═════════════════════════════════════════════════════════════════════
# 🔧 SERVER CONFIGURATION
# ═════════════════════════════════════════════════════════════════════

# Server port
PORT=3000

# Environment: development, staging, production
NODE_ENV=development

# ═════════════════════════════════════════════════════════════════════
# 🗄️  DATABASE CONFIGURATION
# ═════════════════════════════════════════════════════════════════════

DB_HOST=localhost
DB_PORT=3306
DB_USER=db_sekolah
DB_PASSWORD=123
DB_NAME=db_sekolah

# Maximum concurrent database connections
DB_CONNECTION_LIMIT=10

# ═════════════════════════════════════════════════════════════════════
# 🔐 JWT AUTHENTICATION
# ═════════════════════════════════════════════════════════════════════

# ⚠️ IMPORTANT: Change these to random values!
# For production, use: openssl rand -base64 32
# Minimum 32 characters recommended for production
JWT_ACCESS_SECRET=your-secret-key-change-this-to-random-string
JWT_REFRESH_SECRET=your-secret-key-change-this-to-random-string

# Token expiration times
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ═════════════════════════════════════════════════════════════════════
# 🌐 CORS CONFIGURATION
# ═════════════════════════════════════════════════════════════════════

# Frontend URL(s) allowed to access this API
# Multiple URLs: separate with comma (no spaces)
CORS_ORIGIN=http://localhost:5173

# ═════════════════════════════════════════════════════════════════════
# 🤖 AI SERVICES (OPTIONAL)
# ═════════════════════════════════════════════════════════════════════

# Google Gemini API key (required for AI features)
# Get from: https://makersuite.google.com/app/apikey
# Leave empty to disable AI features
GEMINI_API_KEY=your-gemini-api-key-here

# ═════════════════════════════════════════════════════════════════════
# 📝 SETUP INSTRUCTIONS
# ═════════════════════════════════════════════════════════════════════
# 
# 1. Rename this file to .env
# 2. Update database credentials:
#    - DB_USER: MySQL username
#    - DB_PASSWORD: MySQL password
#    - DB_HOST: MySQL server address
#
# 3. For development, simple values are OK
#
# 4. For production, update these:
#    - JWT_ACCESS_SECRET (run: openssl rand -base64 32)
#    - JWT_REFRESH_SECRET (run: openssl rand -base64 32)
#    - NODE_ENV=production
#    - CORS_ORIGIN=https://yourdomain.com
#    - DB_PASSWORD to strong password
#
# 5. Run migrations: npm run migrate
#
# For more details, see: SETUP.md
